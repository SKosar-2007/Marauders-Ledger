# The Marauder's Ledger — Environment Variables
# Copy this file to .env and fill in values before running.
#   cp .env.example .env

# ─────────────────────────────────────────────
# REQUIRED — App will not start without these
# ─────────────────────────────────────────────

# JWT signing secret (use: openssl rand -hex 32)
JWT_SECRET_KEY=

# ─────────────────────────────────────────────
# REQUIRED — Primary database
# ─────────────────────────────────────────────

# Actian VectorAI Community Edition
VECTORAI_HOST=localhost
VECTORAI_PORT=6574
VECTORAI_LICENSE_KEY=

# ─────────────────────────────────────────────
# REQUIRED — Background tasks
# ─────────────────────────────────────────────

# Redis connection URL (format: redis://host:port/db)
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# OPTIONAL — AI services (graceful fallback if unset)
# ─────────────────────────────────────────────

# Google Gemini — generates narrative text for anomalies
# Falls back to static templates if not set
GEMINI_API_KEY=

# ElevenLabs — converts narrative text to audio
# Returns 501 from /api/narratives/{id}/audio if not set
ELEVENLABS_API_KEY=

# ─────────────────────────────────────────────
# OPTIONAL — Advanced
# ─────────────────────────────────────────────

# SQLite database path (used for auth only; VectorAI holds transaction data)
DATABASE_PATH=marauders.db

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
