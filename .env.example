# The Marauder's Ledger — Environment Variables

# Gemini AI (optional — fallback narratives used if not set)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs TTS (optional — audio endpoint returns 501 if not set)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# JWT Secret (change in production!)
JWT_SECRET_KEY=your_jwt_secret_key_here

# SQLite Database Path (auth only — VectorAI is primary for data)
DATABASE_PATH=marauders.db

# Actian VectorAI — Primary Database
VECTORAI_HOST=localhost
VECTORAI_PORT=6574
VECTORAI_LICENSE_KEY=your_actian_license_key_here

# Redis (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0
